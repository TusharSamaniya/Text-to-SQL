# =============================================
# .env.example — the SHARED template (safe to commit)
# Copy this file to .env and fill in YOUR real values.
#   Windows: copy .env.example .env
#   Git Bash: cp .env.example .env
# Never put real secrets in this file!
# =============================================

# --- PostgreSQL: ONE line, all connection info ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/company_db

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_key_here
MODEL_NAME=gemini-flash-lite-latest